#!/usr/bin/expect -f
# qemu-install.expect — boot the Void live VM, log in over the serial console,
# launch the seed autorun.sh, and decide the outcome from its sentinel.
#
# Driven entirely by environment variables:
#   QX_QEMU           full qemu-system-x86_64 command (serial on stdio)
#   QX_LOGFILE        file to mirror the full serial session into
#   QX_TIMEOUT        seconds to allow for the whole install
#   QX_LOGIN_TIMEOUT  seconds to allow for reaching the login prompt (default 600)

set qemu     $env(QX_QEMU)
set logfile  $env(QX_LOGFILE)
set total_to $env(QX_TIMEOUT)
set login_to [expr {[info exists env(QX_LOGIN_TIMEOUT)] ? $env(QX_LOGIN_TIMEOUT) : 600}]

# Mirror everything to the logfile (append) and to our stdout (CI visibility).
log_file -a $logfile
log_user 1

eval spawn $qemu

# --- Phase 1: log in --------------------------------------------------------
# The serial getty (console=ttyS0) shows a normal login prompt; live.autologin
# only affects tty1. Log in as root/voidlinux. We deliberately do NOT try to
# match a bare "# " prompt here: the live MOTD banner contains "# void-installer"
# and rows of "###", which would falsely look like a shell prompt mid-login.
set timeout $login_to
expect {
    -re {(?i)login: *$}    { send "root\r"; exp_continue }
    -re {(?i)password: *$} { send "voidlinux\r" }
    timeout { send_user "\n\[qemu-install] TIMEOUT waiting for the login prompt\n"; exit 2 }
    eof     { send_user "\n\[qemu-install] QEMU exited before the login prompt\n";  exit 4 }
}

# --- Phase 2: confirm a shell, then pin a deterministic prompt --------------
# After the password the shell prints the (noisy) MOTD, so confirm we actually
# have a shell by the OUTPUT of a sentinel echo rather than by prompt shape.
# Re-answer login/password in case the first attempt raced the banner.
set timeout 8
set ready 0
for {set i 0} {$i < 25} {incr i} {
    send "echo QXSHELL_$i\r"
    expect {
        -re "\nQXSHELL_$i\r?\n" { set ready 1; break }
        -re {(?i)login: *$}    { send "root\r" }
        -re {(?i)password: *$} { send "voidlinux\r" }
        timeout { }
    }
}
if {!$ready} { send_user "\n\[qemu-install] TIMEOUT establishing a shell\n"; exit 2 }

send "export PS1='QXREADY# '\r"
set timeout 30
expect {
    -re {QXREADY# $} { }
    timeout { send_user "\n\[qemu-install] TIMEOUT pinning prompt\n"; exit 2 }
}

# --- Phase 3: launch the installer -----------------------------------------
# Mount the seed medium (autorun.sh self-mounts too, but it lives on the seed
# so we must reach it first), then run it. Its output streams over the console.
send "for d in /dev/sr0 /dev/sr1 /dev/sr2 /dev/vdb /dev/vdc; do blkid -o value -s LABEL \$d 2>/dev/null | grep -qx VOIDSEED && { mkdir -p /mnt/seed; mount -o ro \$d /mnt/seed; break; }; done\r"
expect -re {QXREADY# $}
send "if test -f /mnt/seed/autorun.sh; then bash /mnt/seed/autorun.sh; else echo MISSING_SEED_AUTORUN; fi\r"

# --- Phase 4: await the result sentinel ------------------------------------
set timeout $total_to
expect {
    -re {VOID_INSTALL_RESULT: OK}   { send_user "\n\[qemu-install] install OK\n" }
    -re {VOID_INSTALL_RESULT: FAIL} { send_user "\n\[qemu-install] install FAILED\n"; exit 1 }
    -re {MISSING_SEED_AUTORUN}      { send_user "\n\[qemu-install] seed autorun.sh not found\n"; exit 5 }
    timeout { send_user "\n\[qemu-install] TIMEOUT during install\n"; exit 3 }
    eof     { send_user "\n\[qemu-install] QEMU exited without a result\n"; exit 4 }
}

# autorun.sh powers the guest off after signalling; let qemu wind down.
set timeout 180
expect eof
exit 0
